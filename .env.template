# MLflow tracking for classification pipeline
MLFLOW_TRACKING=False

# W&B experiment tracking for extraction pipeline
# Set WANDB_TRACKING=True and provide your API key to enable
WANDB_TRACKING=False
WANDB_API_KEY=              # From https://wandb.ai/authorize
WANDB_PROJECT=swissgeol-boreholes

# Azure ML — required to submit training jobs (src/scripts/azure_jobs/)
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_RESOURCE_GROUP=your_resource_group
AZURE_WORKSPACE_NAME=your_workspace_name
AZURE_COMPUTE_NAME=your_compute_cluster_name
MLFLOW_TRACKING_URI="http://127.0.0.1:5000"

AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_ENDPOINT=your_endpoint_url
AWS_S3_BUCKET=your_bucket_name
AWS_DEFAULT_REGION=your_default_region

# See https://docs.aws.amazon.com/bedrock/latest/userguide/model-cards.html
ANTHROPIC_MODEL_ID="your_model_id"

# BERT_ENABLED: false = skip loading BERT models entirely; extraction endpoints still work,
#               but /classify_lithology will return 503. Useful to save memory when classification
#               is not needed.
#               true = load BERT models and enable lithology classification.
#               Default: False.
BERT_ENABLED=False